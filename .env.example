# Server Configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,https://pioneertrioservices.com,https://www.pioneertrioservices.com

# Database (PostgreSQL)
DATABASE_URL=postgresql://pioneer:dev_password@localhost:5432/pioneer_dev?schema=public&connection_limit=20&pool_timeout=20
DATABASE_TEST_URL=postgresql://pioneer:dev_password@localhost:5432/pioneer_test?schema=public

# Redis (Caching, Rate Limiting, Queues, Sessions)
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secrets & Expiry
JWT_SECRET=super-secure-jwt-secret-pioneer-trio-services-2026-bangladesh
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
BCRYPT_SALT_ROUNDS=12

# File Encryption Key (32-byte hex string for AES-256-GCM)
ENCRYPTION_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Object Storage (AWS S3 / MinIO)
STORAGE_PROVIDER=minio
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_DOCUMENTS=pioneer-documents
S3_BUCKET_PHOTOS=pioneer-photos
S3_FORCE_PATH_STYLE=true

# Email Service (SMTP / Gmail / SendGrid)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=leads@pioneertrioservices.com
SMTP_PASS=app_password_placeholder
EMAIL_FROM="Pioneer Trio Services <noreply@pioneertrioservices.com>"
IMMIGRATION_COORDINATOR_EMAIL=immigration@pioneertrioservices.com
MATRIMONIAL_MATCHMAKER_EMAIL=matrimonial@pioneertrioservices.com
ADMIN_EMAIL=admin@pioneertrioservices.com

# Sentry & Observability
SENTRY_DSN=
LOG_LEVEL=debug

# Rate Limiting
RATE_LIMIT_GLOBAL_MAX=100
RATE_LIMIT_GLOBAL_WINDOW_MS=60000
RATE_LIMIT_AUTH_MAX=5
RATE_LIMIT_AUTH_WINDOW_MS=900000
